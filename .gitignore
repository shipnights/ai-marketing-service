# ── Secrets — never commit ────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
# plaintext key dumps
**/*secret*
**/*credentials*

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# ── Node / Next.js ────────────────────────────────────────────────────────────
node_modules/
.next/
out/
dist/
build/
coverage/
playwright-report/
test-results/

# ── Local dev ─────────────────────────────────────────────────────────────────
uploads/
*.log
.DS_Store
.idea/
.vscode/
