# ── Server ────────────────────────────────────────────────────────────────────
ENV=development
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-random-string-at-least-32-characters
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ── API Key guard (optional) ──────────────────────────────────────────────────
REQUIRE_API_KEY=false
API_KEY=

# ── DynamoDB (local dev) ──────────────────────────────────────────────────────
# For local: use amazon/dynamodb-local via docker-compose (port 8001)
# For production: remove DYNAMODB_ENDPOINT_URL and set real AWS credentials
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
DYNAMODB_ENDPOINT_URL=http://localhost:8001

DYNAMODB_MAIN_TABLE=ai-marketing-dev-main
DYNAMODB_CONTENT_TABLE=ai-marketing-dev-content
DYNAMODB_SCHEDULE_TABLE=ai-marketing-dev-schedule
DYNAMODB_ANALYTICS_TABLE=ai-marketing-dev-analytics
DYNAMODB_ACCOUNTS_TABLE=ai-marketing-dev-accounts

# ── AI ────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Media Generation ──────────────────────────────────────────────────────────
HIGGSFIELD_API_KEY=
OPENAI_API_KEY=sk-...

# ── File Storage ──────────────────────────────────────────────────────────────
STORAGE_DRIVER=local
MEDIA_LOCAL_PATH=./uploads
MEDIA_BASE_URL=http://localhost:8000/uploads
AWS_S3_BUCKET=ai-marketing-media

# ── Meta (Instagram / Facebook) — content publishing ──────────────────────────
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:8000/api/v1/integrations/meta/callback
META_GRAPH_VERSION=v21.0

# ── TikTok — content publishing ───────────────────────────────────────────────
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:8000/api/v1/integrations/tiktok/callback

# ── Paid Ads platforms ────────────────────────────────────────────────────────
# Meta Ads reuses META_APP_ID / META_APP_SECRET above (Marketing API scopes).
META_ADS_REDIRECT_URI=http://localhost:8000/api/v1/integrations/meta_ads/callback

# Google Ads (OAuth client + developer token; login-customer-id only for MCC/manager)
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_REDIRECT_URI=http://localhost:8000/api/v1/integrations/google_ads/callback

# TikTok Ads (separate Business app from TikTok content publishing above)
TIKTOK_ADS_APP_ID=
TIKTOK_ADS_SECRET=
TIKTOK_ADS_REDIRECT_URI=http://localhost:8000/api/v1/integrations/tiktok_ads/callback

# Reddit Ads
REDDIT_ADS_CLIENT_ID=
REDDIT_ADS_CLIENT_SECRET=
REDDIT_ADS_REDIRECT_URI=http://localhost:8000/api/v1/integrations/reddit_ads/callback
REDDIT_USER_AGENT=ai-marketing-service/1.0

# Days of ad insights to pull per sync
ADS_SYNC_LOOKBACK_DAYS=30

# ── Token encryption (OAuth tokens at rest) ───────────────────────────────────
# REQUIRED in production. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# ── Billing (Stripe) ──────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Subscription Price IDs (create Products/Prices in Stripe, then paste IDs here)
STRIPE_PRICE_SOLO_MONTHLY=
STRIPE_PRICE_SOLO_ANNUAL=
STRIPE_PRICE_TEAM_MONTHLY=
STRIPE_PRICE_TEAM_ANNUAL=
STRIPE_PRICE_AGENCY_MONTHLY=
STRIPE_PRICE_AGENCY_ANNUAL=
# One-time AI credit pack Price IDs
STRIPE_PRICE_CREDITS_STARTER=
STRIPE_PRICE_CREDITS_GROWTH=
STRIPE_PRICE_CREDITS_PRO=
STRIPE_PRICE_CREDITS_AGENCY=
# Post-checkout redirects (default to APP_BASE_URL/dashboard/billing)
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=
STRIPE_PORTAL_RETURN_URL=

# ── Email (AWS SES) ───────────────────────────────────────────────────────────
EMAIL_FROM=noreply@yourdomain.com
SUPPORT_EMAIL=support@yourdomain.com
APP_BASE_URL=http://localhost:3000

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT=100/minute

# ── Dev ───────────────────────────────────────────────────────────────────────
# Set to true to allow X-User-Id / X-Team-Id header bypass (never in production)
ENABLE_DEV_AUTH_HEADER=true
STRUCTURED_LOGGING=false
